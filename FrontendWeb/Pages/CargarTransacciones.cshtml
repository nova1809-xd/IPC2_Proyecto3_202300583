@page
@model FrontendWeb.Pages.CargarTransaccionesModel
@{
    ViewData["Title"] = "Cargar transacciones";
}

<div class="container py-4">
    <div class="row justify-content-center">
        <div class="col-lg-8">
            <div class="card shadow-sm border-0">
                <div class="card-header bg-success text-white">
                    <h1 class="h4 mb-0">cargar transacciones</h1>
                </div>
                <div class="card-body">
                    <p class="text-secondary mb-3">sube el archivo <strong>transac.xml</strong> para enviarlo a la api.</p>

                    <form method="post" enctype="multipart/form-data">
                        <div class="mb-3">
                            <label asp-for="ArchivoTransacciones" class="form-label">archivo xml</label>
                            <input asp-for="ArchivoTransacciones" type="file" class="form-control" accept=".xml,text/xml,application/xml" />
                            <span asp-validation-for="ArchivoTransacciones" class="text-danger small"></span>
                        </div>

                        <button type="submit" class="btn btn-success">enviar transacciones</button>
                    </form>

                    @if (!string.IsNullOrWhiteSpace(Model.RespuestaXml))
                    {
                        <hr />
                        <h2 class="h5">respuesta de la api</h2>
                        <pre id="respuestaTransacciones" class="bg-dark text-light border border-secondary rounded p-3 mb-0 xml-output">@Model.RespuestaXml</pre>
                        <button type="button" class="btn btn-outline-secondary mt-2" onclick="descargarSalida('respuestaTransacciones')">Descargar salida.xml</button>
                    }
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        // descarga el xml
        function descargarSalida(idElemento) {
            const elemento = document.getElementById(idElemento);
            if (!elemento) return;

            const blob = new Blob([elemento.textContent || ''], { type: 'text/xml' });
            const url = window.URL.createObjectURL(blob);
            const enlace = document.createElement('a');

            enlace.href = url;
            enlace.download = 'salida.xml';
            document.body.appendChild(enlace);
            enlace.click();
            enlace.remove();
            window.URL.revokeObjectURL(url);
        }
    </script>
}
