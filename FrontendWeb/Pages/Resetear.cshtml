@page
@model FrontendWeb.Pages.ResetearModel
@{
    ViewData["Title"] = "Resetear datos";
}

<div class="container py-4">
    <div class="row justify-content-center">
        <div class="col-lg-7">
            <div class="card shadow-sm border-0">
                <div class="card-header bg-danger text-white">
                    <h1 class="h4 mb-0">resetear datos</h1>
                </div>
                <div class="card-body">
                    <p class="text-muted">este botón borra los registros guardados en la api.</p>

                    <form method="post">
                        <button type="submit" class="btn btn-danger">limpiar datos</button>
                    </form>

                    @if (!string.IsNullOrWhiteSpace(Model.MensajeExito))
                    {
                        <div class="alert alert-success mt-3 mb-0" role="alert">
                            @Model.MensajeExito
                        </div>
                    }

                    @if (!string.IsNullOrWhiteSpace(Model.MensajeError))
                    {
                        <div class="alert alert-danger mt-3 mb-0" role="alert">
                            @Model.MensajeError
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
</div>
